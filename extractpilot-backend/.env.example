# API & Web
PORT=3002
CLIENT_ORIGIN=http://localhost:3000
# Public backend URL (OAuth redirect + external REST). Required in production.
# API_PUBLIC_URL=https://your-api.onrender.com
# Web (production): set API_URL to your public API URL when building/deploying frontend
# API_URL=https://your-api.onrender.com
# Optional: direct client-side API URL on Vercel (otherwise Next.js rewrites proxy /api/v1)
# NEXT_PUBLIC_API_URL=https://your-api.onrender.com

# Google OAuth (dashboard login — signup is automatic on first sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_ACCESS_SECRET=change-me-access-long-random-string

# Closed beta (production)
REST_API_KEY=
ACTIVE_PLAN=free
ENABLE_BILLING=false
BETA_INVITE_ONLY=true
# Skip email/extraction quotas during beta (default on when BETA_INVITE_ONLY=true). Set false to test plan limits.
BETA_UNLIMITED_QUOTA=true

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/email_parser

# Redis / Queue
REDIS_URL=redis://localhost:6379

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-8b
# OPENROUTER_CLASSIFY_MODEL=qwen/qwen3-8b
# OPENROUTER_EXTRACT_MODEL=qwen/qwen3-8b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_DEBUG=true
# Warning: OPENROUTER_DEBUG logs full prompts (may contain PII) — disable in production

# Prompt injection: untrusted email/OCR is delimited in LLM prompts (see packages/features/extraction/src/schema/promptSecurity.ts)
# OPENROUTER_DEBUG_MAX_CHARS=4000

# IMAP (Gmail example)
IMAP_GMAIL_HOST=imap.gmail.com
IMAP_GMAIL_PORT=993
IMAP_GMAIL_USER=
IMAP_GMAIL_PASSWORD=

# Only fetch emails received in the last N hours (default 1)
IMAP_FETCH_SINCE_HOURS=1
# Only fetch unread (UNSEEN) emails
IMAP_UNREAD_ONLY=true
# Mark Gmail \Seen after fetch (best-effort, async). Safer OFF: rely on DB idempotency + skip re-enqueue.
# When ON, timeouts are normal on Gmail IMAP — ingest still succeeds; email may stay unread in Gmail.
IMAP_MARK_SEEN_ON_ENQUEUE=false
# IMAP_DEBUG=true

# Max times a failed email is auto re-queued per extract/cron (default 3). 0 = off.
MAX_FAILED_EMAIL_REQUEUES=3

# Attachments
ATTACHMENTS_ROOT=./data/attachments
MAX_ATTACHMENT_SIZE_MB=25
MAX_ATTACHMENTS_PER_EMAIL=20
ATTACHMENT_FAIL_POLICY=partial
ATTACHMENT_RETENTION_DAYS=7

# PaddleOCR — AI Studio v2 jobs (matches API tab Python script) OR self-hosted layout-parsing
# Jobs (auto-detected when URL contains /api/v2/ocr/jobs):
PADDLEOCR_API_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLEOCR_API_TOKEN=
PADDLEOCR_MODEL=PaddleOCR-VL-1.6
# AI Studio job options (useOcrForImageBlock, promptLabel: ocr, etc.) are set in aistudioJobsOcr.provider.ts
# PADDLEOCR_API_MODE=aistudio-jobs
# PADDLEOCR_POLL_INTERVAL_MS=5000
# PADDLEOCR_JOB_TIMEOUT_MS=300000
# PADDLEOCR_TIMEOUT_MS=120000
# Self-hosted sync API instead:
# PADDLEOCR_API_MODE=layout-parsing
# PADDLEOCR_API_URL=http://localhost:8080/layout-parsing
# PADDLEOCR_PDF_TEXT_MIN_CHARS=50

# Ingestion requires an active user query (set false to allow fetch without one)
REQUIRE_ACTIVE_USER_QUERY=true

# Worker
WORKER_CONCURRENCY=5
MAX_PARALLEL_ATTACHMENT_AI=1
# Attachment parsing mode:
# - stub: keep saving attachments locally but skip AI parsing (EOD-friendly)
# - full: parse attachments with extractor + OpenRouter
ATTACHMENT_MODE=stub
# Step-by-step worker + attachment logs (recommended when testing attachments)
PIPELINE_DEBUG=true

# Logging
# debug|info|warn|error
LOG_LEVEL=info

# Cron
CRON_SCHEDULE=0 * * * *
ENABLE_CRON=false

# Auth (admin UI — legacy; dashboard uses Google OAuth above)
JWT_REFRESH_SECRET=change-me-refresh
