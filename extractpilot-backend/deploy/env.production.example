# Copy to Railway / VPS — replace REPLACE_* placeholders
# See docs/HOST-DEMO.md for step-by-step hosting

# ── API + Worker (both services) ─────────────────────────────────────────────
PORT=3002
DATABASE_URL=REPLACE_NEON_URL
REDIS_URL=REPLACE_REDIS_URL
OPENROUTER_API_KEY=REPLACE_OPENROUTER_KEY
OPENROUTER_MODEL=qwen/qwen3-8b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

REST_API_KEY=REPLACE_GENERATE_LONG_SECRET
CLIENT_ORIGIN=https://REPLACE-WEB-HOST.up.railway.app

ACTIVE_PLAN=free
ENABLE_BILLING=false
BETA_INVITE_ONLY=true
BETA_UNLIMITED_QUOTA=true

PIPELINE_DEBUG=false
# stub = no attachment OCR cost; full = parse PDFs/images (set PADDLEOCR_API_URL)
ATTACHMENT_MODE=stub
ENABLE_CRON=false
REQUIRE_ACTIVE_USER_QUERY=true
WORKER_CONCURRENCY=5
ATTACHMENTS_ROOT=./data/attachments

# Optional IMAP env defaults (users connect via dashboard UI)
IMAP_FETCH_SINCE_HOURS=24
IMAP_UNREAD_ONLY=false

# ── Web service only (set BEFORE build) ──────────────────────────────────────
# API_URL=https://REPLACE-API-HOST.up.railway.app
# NEXT_PUBLIC_DEMO_API_KEY=same-as-REST_API_KEY
# PORT=3000
